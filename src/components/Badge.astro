---
import { t, localePath, type Locale } from '../i18n/strings';
import { SITE } from '../lib/seo';
// Le badge, prêt à coller : la carte façon annuaire de lancement d'abord (le vrai SVG tel qu'il
// s'affichera, en clair et en sombre), puis le badge compact pour qui aligne déjà une rangée de badges.
// Un README s'écrit en Markdown : c'est cette ligne-là qu'on montre en premier.
interface Props { locale: Locale; slug: string; days: number; title: string; seenAt?: string }
const { locale, slug, days, title, seenAt } = Astro.props;
const s = t(locale);
const lang = locale === 'en' ? '&lang=en' : '';
const cardPath = `/api/badge/${slug}.svg?style=card${lang}`;
const compactPath = `/api/badge/${slug}.svg${locale === 'en' ? '?lang=en' : ''}`;
const pageUrl = `${SITE}${localePath(locale, `/app/${slug}`)}`;
const alt = s.badgeAlt(days);
const snippets = (path: string) => [
  [s.badgeMd, `[![${alt}](${SITE}${path})](${pageUrl})`],
  [s.badgeHtml, `<a href="${pageUrl}"><img src="${SITE}${path}" alt="${alt}"></a>`],
];
const seen = seenAt ? new Date(seenAt).toLocaleDateString(locale, { day: 'numeric', month: 'long', year: 'numeric' }) : null;
---
<section class="sk badge-block">
  <h2 class="hand">{title}</h2>
  <div class="cards">
    <img class="card" src={cardPath} alt={alt} width="256" height="54" />
    <img class="card dark" src={`${cardPath}&theme=dark`} alt={alt} width="256" height="54" />
  </div>
  {snippets(cardPath).map(([label, code]) => (
    <div class="snip">
      <div class="top"><span class="hand">{label}</span><button type="button" class="chip copy" data-code={code} data-done={s.copied}>{s.copy}</button></div>
      <pre><code>{code}</code></pre>
    </div>
  ))}
  <small>{s.badgeDark}</small>
  <details>
    <summary class="hand">{s.badgeCompact}</summary>
    <img class="real" src={compactPath} alt={alt} height="28" />
    {snippets(compactPath).map(([label, code]) => (
      <div class="snip">
        <div class="top"><span class="hand">{label}</span><button type="button" class="chip copy" data-code={code} data-done={s.copied}>{s.copy}</button></div>
        <pre><code>{code}</code></pre>
      </div>
    ))}
  </details>
  <small>{s.badgeHint}{seen && <> <b class="hand seen">✓ {s.badgeSeen(seen)}</b></>}</small>
</section>
<script>
  document.querySelectorAll<HTMLButtonElement>('.badge-block .copy').forEach((b) => b.addEventListener('click', async () => {
    await navigator.clipboard.writeText(b.dataset.code ?? '');
    const was = b.textContent; b.textContent = b.dataset.done ?? was;
    setTimeout(() => { b.textContent = was; }, 1600);
  }));
</script>
<style>
.badge-block{padding:18px 20px;display:flex;flex-direction:column;gap:10px;background:var(--paper-2)}
.badge-block h2{font:700 24px/1 var(--hand);margin:0}
.real{align-self:flex-start;height:28px;width:auto}
.cards{display:flex;flex-wrap:wrap;gap:10px}
.card{height:54px;width:auto;max-width:100%}
details{display:flex;flex-direction:column;gap:10px}
details[open]{display:flex}
summary{cursor:pointer;font:700 17px/1 var(--hand);color:var(--pencil)}
details > *+*{margin-top:10px}
.snip{display:flex;flex-direction:column;gap:4px}
.top{display:flex;align-items:center;justify-content:space-between;gap:10px}
.top span{font:700 17px/1 var(--hand);color:var(--pencil)}
.copy{cursor:pointer;font:inherit;font-size:12px}
pre{margin:0;padding:10px 12px;border:1.5px dashed var(--pencil);border-radius:6px;white-space:pre-wrap;word-break:break-all;background:var(--paper);font-size:12px}
small{color:var(--pencil);font-size:13px}
.seen{color:var(--ink);font-size:16px}
</style>
