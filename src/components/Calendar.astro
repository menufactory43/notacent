---
// Le travail jour par jour : un calendrier des 53 dernières semaines, une case par jour, remplie quand il y a eu au moins un commit.
// Rendu côté serveur en SVG, sans script : lisible par un moteur, partageable, et vide de rien quand le registre n'est pas encore là.
import type { Locale } from '../i18n/strings';
interface Props { dates: string[]; locale: Locale; totalDays: number }
const { dates, locale, totalDays } = Astro.props;
const DAY = 86_400_000;
const set = new Set(dates);
const today = new Date(); today.setUTCHours(0, 0, 0, 0);
const dow = (today.getUTCDay() + 6) % 7; // lundi = 0
const start = new Date(today.getTime() - (52 * 7 + dow) * DAY); // le lundi d'il y a 52 semaines
const iso = (d: Date) => d.toISOString().slice(0, 10);
const CELL = 11, GAP = 3, STEP = CELL + GAP, LEFT = 4, TOP = 18;
const weeks = 53;
const cells: { x: number; y: number; on: boolean; d: string }[] = [];
const months: { x: number; label: string }[] = [];
let lastMonth = -1;
for (let w = 0; w < weeks; w++) {
  for (let r = 0; r < 7; r++) {
    const d = new Date(start.getTime() + (w * 7 + r) * DAY);
    if (d > today) break;
    const k = iso(d);
    cells.push({ x: LEFT + w * STEP, y: TOP + r * STEP, on: set.has(k), d: k });
    if (r === 0 && d.getUTCMonth() !== lastMonth) {
      lastMonth = d.getUTCMonth();
      if (w > 0 || d.getUTCDate() <= 7) months.push({ x: LEFT + w * STEP, label: d.toLocaleDateString(locale, { month: 'short', timeZone: 'UTC' }).replace('.', '') });
    }
  }
}
const inYear = cells.filter((c) => c.on).length;
const before = Math.max(0, totalDays - inYear);
const W = LEFT + weeks * STEP, H = TOP + 7 * STEP;
const fr = locale === 'fr';
const caption = fr
  ? `${inYear} jour${inYear > 1 ? 's' : ''} actif${inYear > 1 ? 's' : ''} sur les 12 derniers mois${before ? `, ${before} avant` : ''}`
  : `${inYear} active day${inYear > 1 ? 's' : ''} in the last 12 months${before ? `, ${before} before that` : ''}`;
---
<figure class="cal">
  <svg viewBox={`0 0 ${W} ${H}`} width={W} height={H} role="img" aria-label={caption}>
    {months.map((m) => <text x={m.x} y="11" class="m">{m.label}</text>)}
    {cells.map((c) => <rect x={c.x} y={c.y} width={CELL} height={CELL} rx="2.5" class={c.on ? 'on' : 'off'}><title>{c.d}</title></rect>)}
  </svg>
  <figcaption class="hand">{caption}</figcaption>
</figure>
<style>
.cal{margin:0;overflow-x:auto}
.cal svg{display:block;max-width:100%;height:auto}
.cal .m{font:500 10px var(--mono);fill:var(--pencil)}
.cal .off{fill:var(--faint)}
.cal .on{fill:var(--hilite);stroke:var(--ink);stroke-width:.8}
.cal figcaption{font-size:16px;color:var(--pencil);margin-top:6px}
</style>
