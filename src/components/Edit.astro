---
import Base from '../layouts/Base.astro';
import { t, localePath, type Locale } from '../i18n/strings';
import { currentUser } from '../lib/session';
import { appBySlug, appsByUser, makersOf, canEdit, PRICINGS } from '../lib/db';
import { PLATFORMS } from '../lib/platform';
import { isAdmin } from '../lib/outreach';
import Badge from './Badge.astro';
interface Props { locale: Locale; slug: string }
const { locale, slug } = Astro.props;
const s = t(locale);
const user = await currentUser(Astro.cookies).catch(() => null);
if (!user) return Astro.redirect(`/api/auth/github?lang=${locale}&back=${encodeURIComponent(localePath(locale, `/app/${slug}/modifier`))}`, 302);
const app = await appBySlug(slug).catch(() => null);
// Une fiche non réclamée n'a personne pour la remplir : l'admin peut le faire en attendant son maker.
if (!app || !(canEdit(app, user) || (app.unclaimed && isAdmin(user.login)))) return new Response(null, { status: 404 });
const owner = app.user_id === user.id;
const makers = await makersOf(app.id).catch(() => []);
const TOOLS = ['Claude Code', 'Cursor', 'Lovable', 'Bolt', 'Copilot', 'Codex', 'Autre'];
const mine = (await appsByUser(user.id).catch(() => [])).filter((a) => a.published);
const others = mine.filter((a) => a.slug !== app.slug);
const incomplete = (a: { tagline: string | null; longest: string | null; tool: string | null }) => !a.tagline || !a.longest || !a.tool;
// Une série de fiches publiées d'un coup : on dit où on en est, et « Enregistrer » mène à la suivante.
const batch = (Astro.cookies.get('nac_batch')?.value ?? '').split(',').filter(Boolean);
const pos = batch.indexOf(app.slug);
const inBatch = pos >= 0 && batch.length > 1;
const next = inBatch ? batch[pos + 1] : undefined;
// L'image déjà envoyée reste en base tant qu'on n'en choisit pas une autre : on la montre pour que ce soit clair.
const current = app.has_image ? `/api/img/${app.slug}?v=${Date.now()}` : app.image_url;
// Le revenu ne se lit pas dans le repo : seul le maker peut le déclarer. L'admin qui remplit une fiche non réclamée n'y touche pas.
const maker = canEdit(app, user);
const firstEuro = app.first_euro_at ? new Date(app.first_euro_at).toISOString().slice(0, 10) : null;
const today = new Date().toISOString().slice(0, 10);
const firstCommit = app.first_commit ? new Date(app.first_commit).toISOString().slice(0, 10) : undefined;
const euroLong = firstEuro ? new Date(`${firstEuro}T12:00:00Z`).toLocaleDateString(locale, { day: 'numeric', month: 'long', year: 'numeric' }) : '';
const err = Astro.url.searchParams.get('erreur');
---
<Base locale={locale} path={`/app/${slug}/modifier`} title={s.editTitle}>
  <section class="edit">
    <h1>{s.editTitle} <span class="hand sub">· {app.name}</span></h1>
    <p class="lede">{s.editLede}{inBatch && <span class="hand batch"> · {s.batchOf(pos + 1, batch.length)}</span>}</p>
    {/* La fiche vient d'être réclamée : c'est le moment où le maker a le README ouvert dans l'onglet d'à côté. */}
    {Astro.url.searchParams.get('reclamee') === '1' && !app.private && <div class="claimed-badge"><Badge locale={locale} slug={app.slug} days={app.active_days} title={s.badgeClaimed} /></div>}
    <form method="post" action="/api/apps/update" class="sk" enctype="multipart/form-data">
      {Astro.url.searchParams.get('erreur') === 'image' && <p class="err hand">{s.errImage}</p>}
      {err === 'store' && <p class="err hand">{s.errStore}</p>}
      {err === 'revenu' && <p class="err hand">{s.errRevenue}</p>}
      {err === 'date' && <p class="err hand">{s.errEuroDate}</p>}
      {Astro.url.searchParams.get('reclamee') === '1' && <p class="ok hand">{s.claimed}</p>}
      <input type="hidden" name="slug" value={app.slug} />
      <label><span>{s.fName}</span><input name="name" value={app.name} maxlength="80" /></label>
      <label><span>{s.fTagline}</span><input name="tagline" value={app.tagline ?? app.description ?? ''} maxlength="140" /></label>
      <label><span>{s.fUrl}</span><input name="url" type="url" value={app.url ?? app.homepage ?? ''} placeholder="https://" /></label>
      <label><span>{s.fStore}</span><input name="store_url" type="url" value={app.store_url ?? ''} placeholder="https://apps.apple.com/…" /><small>{s.fStoreHint}</small></label>
      <label class="img"><span>{s.fImage}</span>
        <div class="pick">
          <img id="preview" src={current ?? ''} alt="" hidden={!current} />
          <div><input name="image" type="file" accept="image/png,image/jpeg,image/webp,image/gif" /><small>{current ? s.fImageKeep : s.fImageHint}</small></div>
        </div>
      </label>
      <label><span>{s.fAlt}</span><input name="alternative_to" value={(app.alternative_to ?? []).join(', ')} maxlength="130" placeholder="Notion, Obsidian" /><small>{s.fAltHint}</small></label>
      <label><span>{s.fLongest}</span><textarea name="longest" rows="4" maxlength="600">{app.longest ?? ''}</textarea></label>
      <div class="grid">
        <label><span>{s.fTool}</span>
          <select name="tool">{TOOLS.map((x) => <option value={x} selected={app.tool === x}>{x}</option>)}</select>
        </label>
        <label><span>{s.fPricing}</span>
          <select name="pricing" aria-describedby="pricing-hint">{PRICINGS.map((p) => <option value={p} selected={app.pricing === p}>{s.pricing[p]}</option>)}</select>
        </label>
        <label><span>{s.fStatus}</span>
          <select name="status">
            <option value="polishing" selected={app.status === 'polishing'}>{s.stPolishing}</option>
            <option value="done" selected={app.status === 'done'}>{s.stDone}</option>
            <option value="paused" selected={app.status === 'paused'}>{s.stPaused}</option>
          </select>
        </label>
        <label><span>{s.fPlatform}</span>
          <select name="platform">{PLATFORMS.map((x) => <option value={x} selected={app.platform === x}>{x}</option>)}</select>
        </label>
      </div>
      <small id="pricing-hint" class="under-grid">{s.fPricingHint}</small>
      {maker && !firstEuro && (
        <fieldset class="revenue">
          <legend class="hand">{s.fRevenue}</legend>
          <label class="check"><input type="checkbox" name="revenue_zero" required checked={app.revenue_source === 'declared'} /><span><b>{s.fZero}</b><small>{s.fZeroHint}</small></span></label>
        </fieldset>
      )}
      <label><span>{s.fMakers}</span>
        {owner
          ? <><input name="makers" value={makers.map((m) => m.login).join(', ')} placeholder="login, login" maxlength="80" /><small>{s.fMakersHint}{makers.some((m) => !m.confirmed) && <> · {makers.filter((m) => !m.confirmed).map((m) => `@${m.login}`).join(', ')} : {s.pending}</>}</small></>
          : <><input value={makers.map((m) => m.login).join(', ')} disabled /><small>{s.fMakersRO}</small></>}
      </label>
      <label class="check"><input type="checkbox" name="takeover" checked={app.takeover} /><span><b>{s.fTakeover}</b><small>{s.fTakeoverHint}</small></span></label>
      <div class="actions">
        <button class="sk sk-btn primary" type="submit">{next ? s.saveNext : s.save}</button>
        {next ? <a class="back hand" href={localePath(locale, `/app/${next}/modifier`)}>{s.skip} →</a> : <a class="back hand" href={localePath(locale, `/app/${app.slug}`)}>← {app.name}</a>}
      </div>
    </form>
    {maker && (
      <section class="sk euro" id="premier-euro">
        <h2 class="hand">{s.euroTitle}</h2>
        {firstEuro ? (
          <>
            <p class="set"><span class="stamp1">{locale === 'fr' ? '1er €' : '1st €'}</span> {s.euroSet(euroLong, app.first_euro_days ?? app.active_days)}</p>
            <form method="post" action="/api/apps/premier-euro" class="line">
              <input type="hidden" name="slug" value={app.slug} />
              <input type="date" name="date" value={firstEuro} min={firstCommit} max={today} required aria-label={s.euroDate} />
              <button class="sk sk-btn" type="submit">{s.euroFix}</button>
            </form>
            <form method="post" action="/api/apps/premier-euro">
              <input type="hidden" name="slug" value={app.slug} /><input type="hidden" name="undo" value="1" />
              <button type="submit" class="hand danger">{s.euroUndo}</button>
            </form>
          </>
        ) : (
          <form method="post" action="/api/apps/premier-euro" class="grid2">
            <input type="hidden" name="slug" value={app.slug} />
            <label><span>{s.euroDate}</span><input type="date" name="date" value={today} min={firstCommit} max={today} required /></label>
            <button class="sk sk-btn" type="submit">{s.euroBtn}</button>
            <small>{s.euroHint}</small>
          </form>
        )}
      </section>
    )}
    {owner && <form method="post" action="/api/apps/remove" class="remove" onsubmit={`return confirm(${JSON.stringify(s.removeConfirm)})`}>
      <input type="hidden" name="slug" value={app.slug} />
      <button type="submit" class="hand danger">{s.remove}</button>
    </form>}
    {others.length > 0 && (
      <aside class="others">
        <h2 class="hand">{s.otherCards}</h2>
        <ul>
          {others.map((a) => (
            <li><a href={localePath(locale, `/app/${a.slug}/modifier`)}>{a.name}</a>{incomplete(a) && <span class="chip">{s.toFill}</span>}</li>
          ))}
        </ul>
      </aside>
    )}
  </section>
</Base>
<script>
  const input = document.querySelector<HTMLInputElement>('input[name=image]');
  const img = document.getElementById('preview') as HTMLImageElement | null;
  input?.addEventListener('change', () => {
    const f = input.files?.[0];
    if (!f || !img) return;
    img.src = URL.createObjectURL(f); img.hidden = false;
  });
</script>
<style>
.edit{max-width:640px}
.claimed-badge{margin:0 0 18px}
h1{font:700 44px/1 var(--hand);margin:0 0 6px}
.sub{color:var(--pencil);font-size:30px}
.lede{margin:0 0 20px;color:var(--pencil)}
form{padding:20px 22px;display:grid;gap:14px}
label{display:grid;gap:4px}
label span{font:700 17px/1.2 var(--hand);color:var(--pencil)}
label small{color:var(--pencil);font-size:13px}
.err{color:var(--redpen);font-size:18px;margin:0}
.ok{color:var(--ink);font-size:20px;margin:0;background:var(--mark);display:inline-block;padding:2px 8px}
input[type=file]{border-style:dashed;padding:10px 12px}
.pick{display:flex;gap:14px;align-items:flex-start}
.pick>div{flex:1;display:grid;gap:4px}
#preview{width:96px;height:96px;object-fit:cover;border:2px solid var(--ink);border-radius:var(--sk2);background:var(--paper);flex:none}
input,textarea,select{font:inherit;font-size:16px;color:var(--ink);background:var(--paper);border:2px solid var(--ink);border-radius:var(--sk2);padding:8px 12px;width:100%}
textarea{resize:vertical}
.grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}
.check{display:flex;gap:10px;align-items:flex-start;grid-template-columns:none}
.check input{width:20px;height:20px;margin-top:3px;flex:none}
.check span{display:grid;gap:2px}
.check b{font:700 17px/1.2 var(--hand);color:var(--ink)}
@media (max-width:760px){.grid{grid-template-columns:1fr 1fr}}
.actions{display:flex;gap:12px;align-items:center;flex-wrap:wrap;margin-top:6px}
.back{color:var(--pencil);font-size:18px;text-decoration:none}
.batch{color:var(--redpen)}
.remove{margin:18px 0 0;text-align:right}
.danger{display:inline-block;width:auto;background:none;border:0;padding:0;font-size:17px;color:var(--pencil);cursor:pointer;border-bottom:1.5px dashed var(--faint)}
.danger:hover{color:var(--redpen);border-bottom-color:var(--redpen)}
.under-grid{color:var(--pencil);font-size:13px;margin-top:-8px}
.revenue{border:2px dashed var(--faint);border-radius:var(--sk2);padding:10px 14px 12px;margin:0}
.revenue legend{font:700 19px/1 var(--hand);padding:0 6px;color:var(--ink)}
.euro{margin-top:22px;padding:18px 22px;display:grid;gap:10px}
.euro h2{font:700 26px/1 var(--hand);margin:0}
.euro form{padding:0;display:flex;gap:10px;align-items:end;flex-wrap:wrap}
.euro .grid2 label{flex:1;min-width:180px}
.euro small{color:var(--pencil);font-size:13px;flex-basis:100%}
.euro .set{margin:0}
.euro input[type=date]{width:auto}
.stamp1{display:inline-block;transform:rotate(-4deg);border:3px double var(--redpen);color:var(--redpen);font:700 18px/1 var(--hand);padding:3px 9px;border-radius:12px 40px 14px 44px/40px 12px 44px 14px;background:var(--paper);margin-right:6px}
.others{margin-top:36px;border-top:2px dashed var(--faint);padding-top:16px}
.others h2{font-size:24px;margin:0 0 8px;color:var(--pencil)}
.others ul{list-style:none;padding:0;margin:0;display:flex;flex-wrap:wrap;gap:8px 18px}
.others a{font-weight:700;text-decoration:none;border-bottom:1.5px solid var(--faint)}
.others .chip{margin-left:6px;font-size:12px;padding:0 6px}
@media (max-width:640px){.grid{grid-template-columns:1fr}}
</style>
