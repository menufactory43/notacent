---
import Base from '../layouts/Base.astro';
import { t, localePath, type Locale } from '../i18n/strings';
import { currentUser } from '../lib/session';
import { appBySlug, appsByUser } from '../lib/db';
interface Props { locale: Locale; slug: string }
const { locale, slug } = Astro.props;
const s = t(locale);
const user = await currentUser(Astro.cookies).catch(() => null);
if (!user) return Astro.redirect(`/api/auth/github?lang=${locale}`, 302);
const app = await appBySlug(slug).catch(() => null);
if (!app || app.user_id !== user.id) return new Response(null, { status: 404 });
const TOOLS = ['Claude Code', 'Cursor', 'Lovable', 'Bolt', 'Copilot', 'Codex', 'Autre'];
const mine = (await appsByUser(user.id).catch(() => [])).filter((a) => a.published);
const others = mine.filter((a) => a.slug !== app.slug);
const incomplete = (a: { tagline: string | null; longest: string | null; tool: string | null }) => !a.tagline || !a.longest || !a.tool;
// Une série de fiches publiées d'un coup : on dit où on en est, et « Enregistrer » mène à la suivante.
const batch = (Astro.cookies.get('nac_batch')?.value ?? '').split(',').filter(Boolean);
const pos = batch.indexOf(app.slug);
const inBatch = pos >= 0 && batch.length > 1;
const next = inBatch ? batch[pos + 1] : undefined;
---
<Base locale={locale} path={`/app/${slug}/modifier`} title={s.editTitle}>
  <section class="edit">
    <h1>{s.editTitle} <span class="hand sub">· {app.name}</span></h1>
    <p class="lede">{s.editLede}{inBatch && <span class="hand batch"> · {s.batchOf(pos + 1, batch.length)}</span>}</p>
    <form method="post" action="/api/apps/update" class="sk" enctype="multipart/form-data">
      {Astro.url.searchParams.get('erreur') === 'image' && <p class="err hand">{s.errImage}</p>}
      <input type="hidden" name="slug" value={app.slug} />
      <label><span>{s.fName}</span><input name="name" value={app.name} maxlength="80" /></label>
      <label><span>{s.fTagline}</span><input name="tagline" value={app.tagline ?? app.description ?? ''} maxlength="140" /></label>
      <label><span>{s.fUrl}</span><input name="url" type="url" value={app.url ?? app.homepage ?? ''} placeholder="https://" /></label>
      <label><span>{s.fImage}</span><input name="image" type="file" accept="image/png,image/jpeg,image/webp,image/gif" /><small>{s.fImageHint}</small></label>
      <label><span>{s.fLongest}</span><textarea name="longest" rows="4" maxlength="600">{app.longest ?? ''}</textarea></label>
      <div class="grid">
        <label><span>{s.fTool}</span>
          <select name="tool">{TOOLS.map((x) => <option value={x} selected={app.tool === x}>{x}</option>)}</select>
        </label>
        <label><span>{s.fPricing}</span>
          <select name="pricing">
            <option value="free" selected={app.pricing === 'free'}>{s.pFree}</option>
            <option value="donations" selected={app.pricing === 'donations'}>{s.pDonations}</option>
            <option value="paid" selected={app.pricing === 'paid'}>{s.pPaid}</option>
          </select>
        </label>
        <label><span>{s.fStatus}</span>
          <select name="status">
            <option value="polishing" selected={app.status === 'polishing'}>{s.stPolishing}</option>
            <option value="done" selected={app.status === 'done'}>{s.stDone}</option>
            <option value="paused" selected={app.status === 'paused'}>{s.stPaused}</option>
          </select>
        </label>
      </div>
      <div class="actions">
        <button class="sk sk-btn primary" type="submit">{next ? s.saveNext : s.save}</button>
        {next ? <a class="back hand" href={localePath(locale, `/app/${next}/modifier`)}>{s.skip} →</a> : <a class="back hand" href={localePath(locale, `/app/${app.slug}`)}>← {app.name}</a>}
      </div>
    </form>
    <form method="post" action="/api/apps/remove" class="remove" onsubmit={`return confirm(${JSON.stringify(s.removeConfirm)})`}>
      <input type="hidden" name="slug" value={app.slug} />
      <button type="submit" class="hand danger">{s.remove}</button>
    </form>
    {others.length > 0 && (
      <aside class="others">
        <h2 class="hand">{s.otherCards}</h2>
        <ul>
          {others.map((a) => (
            <li><a href={localePath(locale, `/app/${a.slug}/modifier`)}>{a.name}</a>{incomplete(a) && <span class="chip">{s.toFill}</span>}</li>
          ))}
        </ul>
      </aside>
    )}
  </section>
</Base>
<style>
.edit{max-width:640px}
h1{font:700 44px/1 var(--hand);margin:0 0 6px}
.sub{color:var(--pencil);font-size:30px}
.lede{margin:0 0 20px;color:var(--pencil)}
form{padding:20px 22px;display:grid;gap:14px}
label{display:grid;gap:4px}
label span{font:700 17px/1.2 var(--hand);color:var(--pencil)}
label small{color:var(--pencil);font-size:13px}
.err{color:var(--redpen);font-size:18px;margin:0}
input[type=file]{border-style:dashed;padding:10px 12px}
input,textarea,select{font:inherit;font-size:16px;color:var(--ink);background:var(--paper);border:2px solid var(--ink);border-radius:var(--sk2);padding:8px 12px;width:100%}
textarea{resize:vertical}
.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}
.actions{display:flex;gap:12px;align-items:center;flex-wrap:wrap;margin-top:6px}
.back{color:var(--pencil);font-size:18px;text-decoration:none}
.batch{color:var(--redpen)}
.remove{margin:18px 0 0;text-align:right}
.danger{display:inline-block;width:auto;background:none;border:0;padding:0;font-size:17px;color:var(--pencil);cursor:pointer;border-bottom:1.5px dashed var(--faint)}
.danger:hover{color:var(--redpen);border-bottom-color:var(--redpen)}
.others{margin-top:36px;border-top:2px dashed var(--faint);padding-top:16px}
.others h2{font-size:24px;margin:0 0 8px;color:var(--pencil)}
.others ul{list-style:none;padding:0;margin:0;display:flex;flex-wrap:wrap;gap:8px 18px}
.others a{font-weight:700;text-decoration:none;border-bottom:1.5px solid var(--faint)}
.others .chip{margin-left:6px;font-size:12px;padding:0 6px}
@media (max-width:640px){.grid{grid-template-columns:1fr}}
</style>
