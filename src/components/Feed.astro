---
import { t, localePath, type Locale } from '../i18n/strings';
import { recentActivity } from '../lib/db';
// « En ce moment » : le fil, dans la colonne du hero. Une raison de revenir.
interface Props { locale: Locale }
const { locale } = Astro.props;
const s = t(locale);
const rows = await recentActivity(5).catch(() => []);
const what = (r: (typeof rows)[number]) =>
  r.kind === 'arrived' ? s.kindArrived : r.kind === 'sponsor' ? s.kindSponsor : r.kind === 'takeover' ? s.kindTakeover : r.kind === 'claimed' ? s.kindClaimed : r.kind === 'day' ? s.kindDay(Number(r.payload.n ?? 0)) : r.payload.status === 'done' ? s.kindDone : s.kindPaused;
const items = rows.length
  ? rows.map((r) => ({ l: r.name[0], name: r.name, href: localePath(locale, `/app/${r.slug}`), what: what(r), when: s.agoAuto(Date.now() - new Date(r.created_at).getTime()) }))
  : [
      { l: 'S', name: 'Sémaphore', href: localePath(locale, '/app/semaphore'), what: s.nthDay(168), when: s.ago(12, 'min') },
      { l: 'D', name: 'Daybard', href: localePath(locale, '/app/daybard'), what: s.kindTakeover, when: s.ago(3, 'h') },
      { l: 'C', name: 'Correspondance', href: localePath(locale, '/app/correspondance'), what: s.kindWeek, when: s.ago(1, 'j') },
      { l: '¢', name: 'Not a Cent', href: localePath(locale, '/app/notacent'), what: s.arrived, when: s.ago(2, 'j') },
    ];
---
<aside class="sk activity" aria-label={s.now}>
  <h2>{s.now}</h2>
  {items.map((i) => (
    <a href={i.href}><div class="logo-app">{i.l}</div><div class="t"><b>{i.name}</b> <span>{i.what}</span><br /><span class="when hand">{i.when}</span></div></a>
  ))}
  <a class="all hand" href={localePath(locale, '/intention/new')}>{s.allFeed} →</a>
</aside>
<style>
.activity{padding:16px 18px 12px;display:flex;flex-direction:column;gap:10px;transform:rotate(.6deg);background:var(--paper-2)}
h2{font:700 26px/1 var(--hand);margin:0;display:flex;align-items:center;gap:8px}
h2::before{content:"";width:10px;height:10px;border-radius:50%;background:var(--redpen);display:inline-block}
.activity>a{display:flex;gap:10px;align-items:center;text-decoration:none;font-size:14px;color:var(--pencil)}
.activity .logo-app{width:34px;height:34px;font-size:17px}
.t{min-width:0}
.t b{color:var(--ink)}
.when{font:500 15px/1 var(--hand)}
.all{border-top:2px dashed var(--faint);padding-top:10px;margin-top:2px;font:700 17px/1 var(--hand)!important;color:var(--pencil)}
</style>
