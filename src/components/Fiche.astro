---
import Base from '../layouts/Base.astro';
import { t, localePath, type Locale } from '../i18n/strings';
import type { App } from '../data/apps';
import { currentUser } from '../lib/session';
import { stripeReady, sponsorDays, sponsorCents, sponsorCurrency } from '../lib/stripe';
import { sponsorUntil, activeSponsor, rankIn, relatedApps, type DbApp } from '../lib/db';
import { toView } from '../lib/view';
import { softwareLd, breadcrumbLd, SITE } from '../lib/seo';
import { browsePath, browseLabel } from '../lib/browse';
import { apps as samples } from '../data/apps';
interface Props { locale: Locale; app: App; ownerId?: number; sample?: boolean; appId?: number; row?: DbApp }
const { locale, app, ownerId, sample, appId, row } = Astro.props;
const s = t(locale);
const user = await currentUser(Astro.cookies).catch(() => null);
const mine = Boolean(user && ownerId && user.id === ownerId);
const since = new Date(app.firstCommit).toLocaleDateString(locale, { month: 'short', year: 'numeric' });
const stamp = app.pricing === 'donations' ? s.donations : app.pricing === 'paid' ? '€' : s.free;
const stateNote = app.status === 'done' ? s.doneStatus : app.status === 'paused' ? s.paused : '';
const until = appId ? await sponsorUntil(appId).catch(() => null) : null;
const someoneElse = appId && !until ? await activeSponsor().catch(() => null) : null;
const price = new Intl.NumberFormat(locale, { style: 'currency', currency: sponsorCurrency().toUpperCase(), maximumFractionDigits: 0 }).format(sponsorCents() / 100);
const sp = Astro.url.searchParams.get('sponsor');
const sponsorMsg = sp === 'merci' ? s.sponsorThanks : sp === 'erreur' ? s.sponsorErr : '';
// Fil d'Ariane et maillage : la fiche dit d'où elle vient (outil, plateforme) et vers quoi elle mène (trois apps proches).
const toolLink = app.tool && app.tool !== 'Autre' ? { href: browsePath({ kind: 'tool', value: app.tool }, locale), label: browseLabel({ kind: 'tool', value: app.tool }, locale) } : null;
const platLink = app.platform && app.platform !== 'Autre' ? { href: browsePath({ kind: 'platform', value: app.platform }, locale), label: browseLabel({ kind: 'platform', value: app.platform }, locale) } : null;
const langLink = app.language ? { href: browsePath({ kind: 'language', value: app.language }, locale), label: app.language } : null;
const [rankTool, rankPlat, rankAll] = row ? await Promise.all([rankIn(row, 'tool'), rankIn(row, 'platform'), rankIn(row, 'all')]).catch(() => [null, null, null]) : [null, null, null];
const rankParts = [
  rankAll && s.rankIn(s.rankOf(rankAll), locale === 'fr' ? 'apps du classement' : 'all apps'),
  rankTool && toolLink && s.rankIn(s.rankOf(rankTool), toolLink.label),
  rankPlat && platLink && s.rankIn(s.rankOf(rankPlat), platLink.label),
].filter(Boolean) as string[];
const related = row ? (await relatedApps(row).catch(() => [])).map(toView) : sample ? samples.filter((a) => a.slug !== app.slug && !a.sponsored).slice(0, 3) : [];
const badgeUrl = `${SITE}/api/badge/${app.slug}.svg${locale === 'en' ? '?lang=en' : ''}`;
const pageUrl = `${SITE}${localePath(locale, `/app/${app.slug}`)}`;
const snippet = `<a href="${pageUrl}"><img src="${badgeUrl}" alt="${s.badgeAlt(app.activeDays)}"></a>`;
const host = (() => { try { return app.url ? new URL(app.url).host : ''; } catch { return ''; } })();
// Fiche non réclamée : créée depuis le repo public. Pas de dofollow ni de badge tant que le maker ne l'a pas prise en main.
const unclaimed = Boolean(app.unclaimed) && !mine;
const claimHref = `/api/auth/github?lang=${locale}&back=${encodeURIComponent(localePath(locale, `/app/${app.slug}/modifier`))}`;
const crumbs: [string, string][] = [[s.home, '/'], ...(toolLink ? [[toolLink.label, toolLink.href.replace(/^\/en/, '')] as [string, string]] : []), ...(platLink ? [[platLink.label, platLink.href.replace(/^\/en/, '')] as [string, string]] : []), [app.name, `/app/${app.slug}`]];
const ld = sample ? undefined : [softwareLd(app, locale), breadcrumbLd(locale, crumbs)];
---
<Base locale={locale} path={`/app/${app.slug}`} title={app.name} description={app.tagline ?? app.longest[locale]} image={`/api/og/${app.slug}.png${locale === 'fr' ? '' : '?lang=en'}`} jsonLd={ld}>
  {sample && <p class="examples hand">{s.examples}</p>}
  <p class="crumb">{crumbs.slice(0, -1).map((c) => <><a href={localePath(locale, c[1])}>{c[0]}</a> › </>)}<span>{app.name}</span></p>
  <article class="sk fiche">
    <span class="stamp">{stamp}</span>
    <div class="shot">
      {app.imageUrl ? <img src={app.imageUrl} alt="" loading="lazy" /> : <canvas id="shot" width="520" height="390" aria-hidden="true"></canvas>}
    </div>
    <div class="cartel">
      <h1>{app.name} {stateNote && <span class="state hand">· {stateNote}</span>}</h1>
      {app.tagline && <p class="tagline">{app.tagline}</p>}
      <p class="meta">{s.by} <a href={`https://github.com/${app.owner}`} rel="noopener">@{app.owner}</a> · {toolLink ? <a href={toolLink.href}>{app.tool}</a> : app.tool} · {langLink ? <a href={langLink.href}>{app.language}</a> : app.language}{platLink && <> · <a href={platLink.href}>{app.platform}</a></>} · {s.since} <span class="mono">{since}</span></p>
      {app.longest[locale] && (
        <blockquote class="quote">
          {app.longest[locale]}
          <small>{s.longest}</small>
        </blockquote>
      )}
      <div class="stats">
        <div><b class="mono">{app.activeDays}</b><span>{s.days}</span></div>
        <div><b class="mono">{app.commits.toLocaleString(locale)}</b><span>{s.commits}</span></div>
        <div><b class="mono">{app.lifetimeMonths} <i>{s.months}</i></b><span>{s.lifetime}</span></div>
        <div><b class="mono">{app.bestStreakWeeks} <i>{s.weeks}</i></b><span>{s.streak}</span></div>
        <div><b class="mono">★ {(app.stars ?? 0).toLocaleString(locale)}</b><span>{s.stars}</span></div>
      </div>
      <div class="actions">
        <button class="sk sk-btn primary bravo" type="button" data-slug={app.slug} data-already={s.already}>✋ {s.bravo} · <span class="count mono">{app.bravos}</span></button>
        {app.url && <a class="sk sk-btn" href={sample ? app.url : `/api/apps/go?slug=${app.slug}`} rel={unclaimed ? 'nofollow noopener' : 'noopener'}>{s.open} ↗</a>}
        {app.repo && <a class="sk sk-btn" href={app.repo} rel="noopener">{s.repo}</a>}
        {mine && <a class="sk sk-btn" href={localePath(locale, `/app/${app.slug}/modifier`)}>✎ {s.edit}</a>}
      </div>
      {host && !unclaimed && <p class="dofollow hand">{s.dofollow(host)} · {app.clicks.toLocaleString(locale)} {s.clicks} · {s.verifiedAt}</p>}
      {!user && !sample && !unclaimed && <p class="yours hand"><a href={claimHref}>{s.yours}</a></p>}
      {sponsorMsg && <p class="sponsor-msg hand">{sponsorMsg}</p>}
      {until && <p class="sponsor-msg hand">★ {s.sponsorUntil(new Date(until).toLocaleDateString(locale))}</p>}
      {mine && stripeReady() && !until && (
        <form method="post" action="/api/sponsor/checkout" class="sponsor">
          <input type="hidden" name="slug" value={app.slug} />
          <button class="sk sk-btn" type="submit">★ {s.sponsorBtn(sponsorDays(), price)}</button>
          <small class="hand">{someoneElse ? s.sponsorQueue : s.sponsorNote}</small>
        </form>
      )}
    </div>
  </article>

  <div class="under">
    {app.takeover && (
      <section class="sk takeover">
        <span class="tstamp hand">{s.takeoverTitle}</span>
        <p>{s.takeoverText(app.owner)}</p>
        <div class="actions">
          <a class="sk sk-btn primary" href={`https://github.com/${app.owner}`} rel="noopener">{s.contact(app.owner)}</a>
          <a class="sk sk-btn" href={browsePath({ kind: 'intent', value: 'takeover' }, locale)}>{browseLabel({ kind: 'intent', value: 'takeover' }, locale)}</a>
        </div>
        <small class="hand">{s.takeoverNote}</small>
      </section>
    )}
    {unclaimed ? (
      <section class="sk takeover claim">
        <span class="tstamp hand">{s.unclaimedTitle}</span>
        <p>{s.unclaimedText(app.owner, app.activeDays)}</p>
        <div class="actions">
          <a class="sk sk-btn primary" href={claimHref}>{s.claimBtn}</a>
        </div>
        <small class="hand">{s.unclaimedNote}</small>
      </section>
    ) : (
      <section class="sk badge-block">
        <h2 class="hand">{s.badgeTitle}</h2>
        <span class="badge"><b class="mono">{app.activeDays}</b> {s.days} <span class="hand v">{s.verified}</span></span>
        <pre><code>{snippet}</code></pre>
        <small>{s.badgeHint}</small>
      </section>
    )}
  </div>

  {related.length > 0 && (
    <section class="related">
      <div class="sh">
        <h2 class="hand">{s.related}</h2>
        <div class="chips">{[toolLink, platLink, langLink].filter(Boolean).map((l) => <a class="chip" href={l!.href}>{l!.label}</a>)}</div>
      </div>
      <div class="grid">
        {related.map((r) => (
          <a class="sk rel" href={localePath(locale, `/app/${r.slug}`)}><div class="logo-app">{r.imageUrl ? <img src={r.imageUrl} alt="" loading="lazy" /> : r.name[0]}</div><div><b>{r.name}</b><br /><span>{r.activeDays} {s.days} · {r.tool}{r.platform && <> · {r.platform}</>}</span></div></a>
        ))}
      </div>
      {rankParts.length > 0 && <p class="ranks">{s.rankSentence(app.name, rankParts)}</p>}
    </section>
  )}
</Base>
<style>
.crumb{color:var(--pencil);font-size:14px;margin:0 0 18px}
.crumb a{color:inherit;text-decoration:none}
.crumb a:hover{text-decoration:underline}
.crumb span{color:var(--ink)}
.meta a{color:inherit}
.dofollow{margin:10px 0 0;font:500 15px/1.3 var(--hand);color:var(--pencil)}
.under{display:grid;grid-template-columns:1fr 1fr;gap:22px;margin-top:26px}
.under>:only-child{grid-column:1/-1;max-width:560px}
.takeover{padding:18px 20px;display:flex;flex-direction:column;gap:10px;position:relative;border-style:dashed}
.tstamp{position:absolute;left:18px;top:-14px;transform:rotate(-4deg);border:3px double var(--ink);font:700 18px/1 var(--hand);padding:4px 10px;border-radius:12px 40px 14px 44px/40px 12px 44px 14px;background:var(--paper)}
.takeover p{margin:8px 0 0;max-width:52ch}
.takeover small{color:var(--pencil);font-size:15px}
.badge-block{padding:18px 20px;display:flex;flex-direction:column;gap:10px;background:var(--paper-2)}
.badge-block h2{font:700 24px/1 var(--hand);margin:0}
.badge{display:inline-flex;align-items:center;gap:6px;border:1.5px solid var(--ink);border-radius:8px 30px 10px 34px/30px 8px 34px 10px;padding:5px 12px;font-size:14px;align-self:flex-start;background:var(--paper)}
.badge .mono{font-weight:500}
.badge .v{font:700 15px/1 var(--hand);color:var(--redpen)}
.badge-block pre{margin:0;padding:10px 12px;border:1.5px dashed var(--pencil);border-radius:6px;white-space:pre-wrap;word-break:break-all;background:var(--paper);font-size:12px}
.badge-block small{color:var(--pencil);font-size:13px}
.related{margin-top:30px}
.related .sh{display:flex;align-items:baseline;justify-content:space-between;gap:16px;flex-wrap:wrap;margin:0 0 12px}
.related h2{font:700 28px/1 var(--hand);margin:0}
.chips{display:flex;gap:6px;flex-wrap:wrap}
.chips .chip{text-decoration:none}
.related .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
.rel{padding:12px 14px;display:flex;gap:10px;align-items:center;text-decoration:none}
.rel .logo-app{width:36px;height:36px;font-size:18px}
.rel span{color:var(--pencil);font-size:13px}
.ranks{color:var(--pencil);font-size:14px;margin:10px 0 0}
@media (max-width:760px){.under{grid-template-columns:1fr}.related .grid{grid-template-columns:1fr}}
.examples{color:var(--redpen);font-size:17px;margin:0 0 14px}
.fiche{display:grid;grid-template-columns:1fr 1fr;gap:28px;padding:26px 28px;position:relative}
.shot{border:2px solid var(--ink);border-radius:var(--sk2);aspect-ratio:4/3;background:var(--paper-2);overflow:hidden}
.shot canvas,.shot img{width:100%;height:100%;display:block;object-fit:cover}
h1{font:700 40px/1 var(--hand);margin:0 0 2px}
.state{font-size:24px;color:var(--pencil)}
.tagline{font-size:18px;margin:2px 0 6px;max-width:48ch}
.meta{color:var(--pencil);font-size:14px;margin:0 0 14px}
.quote{border-left:3px solid var(--hilite);padding:6px 14px;margin:0 0 18px;font-style:italic;max-width:48ch}
.quote small{display:block;font-style:normal;font:700 15px/1.4 var(--hand);color:var(--pencil);margin-top:4px}
.stats{display:grid;grid-template-columns:repeat(5,1fr);gap:8px;margin:0 0 18px}
.stats div{padding:8px 0;border-top:1.5px solid var(--faint)}
.stats b{display:block;font-size:24px;line-height:1.1;font-weight:500}
.stats i{font-style:normal;font:500 14px/1 var(--hand)}
.stats span{font:500 14px/1.2 var(--hand);color:var(--pencil)}
.stamp{position:absolute;right:22px;top:-18px;transform:rotate(-7deg);border:3px double var(--redpen);color:var(--redpen);font:700 22px/1 var(--hand);padding:6px 12px;border-radius:12px 40px 14px 44px/40px 12px 44px 14px;background:var(--paper)}
.actions{display:flex;gap:10px;flex-wrap:wrap;align-items:center}
.bravo.given{background:var(--paper-2);color:var(--pencil)}
.sponsor{margin-top:16px;display:flex;gap:10px;align-items:center;flex-wrap:wrap}
.sponsor small{color:var(--pencil);font-size:16px}
.sponsor-msg{margin:14px 0 0;color:var(--redpen);font-size:19px}
.yours{margin:12px 0 0;font-size:17px}
.yours a{color:var(--pencil);text-decoration:none;border-bottom:1.5px dashed var(--faint)}
.yours a:hover{color:var(--ink);border-bottom-color:var(--ink)}
@media (max-width:760px){.fiche{grid-template-columns:1fr}.stats{grid-template-columns:repeat(2,1fr)}}
</style>
<script>
  import rough from 'roughjs';
  const css = getComputedStyle(document.documentElement);
  const ink = css.getPropertyValue('--ink').trim();
  const hil = css.getPropertyValue('--hilite').trim();
  const red = css.getPropertyValue('--redpen').trim();
  const c = document.getElementById('shot') as HTMLCanvasElement | null;
  if (c) {
    const W = c.width, H = c.height, rc = rough.canvas(c), o = { stroke: ink, strokeWidth: 1.6, roughness: 1.3, seed: 5 };
    rc.rectangle(24, 24, W - 48, H - 48, o);
    rc.line(24, 64, W - 24, 64, o);
    rc.rectangle(24, 64, 150, H - 88, { ...o, fill: hil, fillStyle: 'hachure', hachureGap: 7, fillWeight: 1 });
    for (let i = 0; i < 6; i++) rc.line(40, 90 + i * 38, 150, 90 + i * 38, { ...o, strokeWidth: 1, seed: 10 + i });
    for (let i = 0; i < 4; i++) { rc.rectangle(196, 84 + i * 68, W - 236, 52, { ...o, seed: 20 + i }); rc.line(212, 112 + i * 68, W - 80, 112 + i * 68, { ...o, strokeWidth: 1, seed: 30 + i }); }
    rc.circle(60, 44, 12, { fill: red, fillStyle: 'solid', stroke: red });
    rc.circle(84, 44, 12, { fill: hil, fillStyle: 'solid', stroke: hil });
    rc.circle(108, 44, 12, { fill: '#6DBE7B', fillStyle: 'solid', stroke: '#6DBE7B' });
  }
  const b = document.querySelector<HTMLButtonElement>('.bravo');
  b?.addEventListener('click', async () => {
    const n = b.querySelector('.count')!;
    b.disabled = true;
    try {
      const r = await fetch('/api/apps/bravo', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ slug: b.dataset.slug }) });
      if (r.ok) { const j = await r.json(); n.textContent = String(j.bravos); if (j.already) b.title = b.dataset.already ?? ''; b.classList.add('given'); }
      else n.textContent = String(Number(n.textContent) + 1);
    } catch { n.textContent = String(Number(n.textContent) + 1); }
  });
</script>
