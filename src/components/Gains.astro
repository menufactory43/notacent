---
import { t, type Locale } from '../i18n/strings';
// Ce que le maker gagne à être listé. Tout est gratuit : c'est l'argument, on le dit noir sur blanc.
interface Props { locale: Locale; days?: number }
const { locale, days = 214 } = Astro.props;
const s = t(locale);
---
<section class="gains">
  <div class="sh">
    <h2>{s.gainsTitle}</h2>
    <span class="hand sub">{s.gainsSub}</span>
  </div>
  <div class="grid">
    <div class="sk card">
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
      <b>{s.gain1t}</b><span>{s.gain1}</span>
    </div>
    <div class="sk card">
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7 0l3-3a5 5 0 0 0-7-7l-1 1"/><path d="M14 11a5 5 0 0 0-7 0l-3 3a5 5 0 0 0 7 7l1-1"/></svg>
      <b>{s.gain2t}</b><span>{s.gain2}</span>
    </div>
    <div class="sk card">
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 2l3 6 6 1-4.5 4.5L18 20l-6-3-6 3 1.5-6.5L3 9l6-1z"/></svg>
      <b>{s.gain3t}</b>
      <span class="badge"><b class="mono">{days}</b> {s.days} <span class="hand v">{s.verified}</span></span>
      <span>{s.gain3}</span>
    </div>
    <div class="sk card">
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20 7h-9M14 17H5"/><circle cx="17" cy="17" r="3"/><circle cx="7" cy="7" r="3"/></svg>
      <b>{s.gain4t}</b><span>{s.gain4}</span>
    </div>
  </div>
</section>
<style>
.gains{margin:0 0 52px}
.sh{display:flex;align-items:baseline;justify-content:space-between;gap:16px;flex-wrap:wrap;margin:0 0 14px}
.sh h2{font:700 30px/1 var(--hand);margin:0}
.sub{font:500 18px/1 var(--hand);color:var(--pencil)}
.grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}
.card{padding:14px 16px;display:flex;flex-direction:column;gap:6px;font-size:14px;color:var(--pencil)}
.card>b{font-size:16px;color:var(--ink)}
.badge{display:inline-flex;align-items:center;gap:6px;white-space:nowrap;flex-wrap:wrap;border:1.5px solid var(--ink);border-radius:8px 30px 10px 34px/30px 8px 34px 10px;padding:4px 10px;font-size:13px;color:var(--ink);align-self:flex-start;margin:2px 0}
.badge .mono{font-weight:500}
.badge .v{font:700 14px/1 var(--hand);color:var(--redpen)}
@media (max-width:760px){.grid{grid-template-columns:1fr 1fr}}
@media (max-width:480px){.grid{grid-template-columns:1fr}}
</style>
