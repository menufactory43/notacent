---
import Base from '../layouts/Base.astro';
import Row from './Row.astro';
import Feed from './Feed.astro';
import Gains from './Gains.astro';
import Gems from './Gems.astro';
import Browse from './Browse.astro';
import { t, localePath, type Locale } from '../i18n/strings';
import { apps as samples, ranked as rankedSamples } from '../data/apps';
import { rankedApps, doneApps, firstEuroApps, browseApps, activeSponsor, weeklyGems } from '../lib/db';
import { toView } from '../lib/view';
import { githubReady } from '../lib/github';
import { siteLd } from '../lib/seo';
import { browsePath, TOOLS } from '../lib/browse';
interface Props { locale: Locale }
const { locale } = Astro.props;
const s = t(locale);
const q = Astro.url.searchParams;
const tab = (['all', 'month', 'new', 'race', 'euro', 'done'] as const).find((x) => x === q.get('t')) ?? (q.get('p') === 'month' ? 'month' : q.get('etat') === 'done' ? 'done' : 'all');
const tool = q.get('tool') ?? '';
const tools = TOOLS.filter((x) => x !== 'Autre');

// Le classement selon l'onglet. « En course » = un commit dans les sept derniers jours, par jours actifs du mois.
let real = (
  tab === 'done' ? await doneApps() : tab === 'euro' ? await firstEuroApps() : tab === 'new' ? await browseApps({ kind: 'intent', value: 'new' }) : await rankedApps(tab === 'month' || tab === 'race' ? 'month' : 'all')
).map(toView);
if (tab === 'race') real = real.filter((a) => a.lastCommitDaysAgo <= 7);
if (tool) real = real.filter((a) => a.tool === tool);
const isSample = real.length === 0 && tab === 'all' && !tool;
const board = isSample ? rankedSamples('all') : real;
const realSponsor = await activeSponsor().catch(() => null);
const sponsor = realSponsor ? toView(realSponsor) : isSample ? samples.find((a) => a.sponsored) : undefined;

// Les pépites : trois tampons décernés par le repo. En mode exemple, on les prend dans les échantillons.
const g = isSample ? null : await weeklyGems().catch(() => null);
const gems = g
  ? { week: g.week && toView(g.week), streak: g.streak && toView(g.streak), radar: g.radar && toView(g.radar) }
  : isSample ? { week: samples[0], streak: samples[1], radar: samples[3] } : { week: null, streak: null, radar: null };
const gemStamp = (slug: string) => (gems.week?.slug === slug ? 'week' : gems.streak?.slug === slug ? 'streak' : gems.radar?.slug === slug ? 'radar' : undefined);

const notice = q.get('retiree') ? s.removed : q.get('soon') ? s.soon : q.get('erreur') === 'session' ? s.errSession : q.get('erreur') ? s.errGithub : q.get('alerte') === 'bye' ? s.alertBye : '';
const link = (params: Record<string, string>) => {
  const u = new URLSearchParams();
  const merged = { t: tab === 'all' ? '' : tab, tool, ...params };
  for (const [k, v] of Object.entries(merged)) if (v) u.set(k, v);
  const qs = u.toString();
  return localePath(locale, '/') + (qs ? `?${qs}` : '') + '#board';
};
const tabs: [typeof tab, string][] = [['all', s.tabAll], ['month', s.tabMonth], ['new', s.tabNew], ['race', s.tabRace], ['euro', s.tabEuro], ['done', s.tabDone]];
const seek = [
  { label: s.seekMac, href: browsePath({ kind: 'platform', value: 'Mac' }, locale) },
  { label: s.seekCli, href: browsePath({ kind: 'platform', value: 'CLI' }, locale) },
  { label: s.seekClaude, href: browsePath({ kind: 'tool', value: 'Claude Code' }, locale) },
  { label: s.seekRadar, href: browsePath({ kind: 'intent', value: 'radar' }, locale) },
  { label: s.seekTakeover, href: browsePath({ kind: 'intent', value: 'takeover' }, locale) },
];
---
<Base locale={locale} path="/" jsonLd={isSample ? undefined : siteLd(locale, board)}>
  {notice && <p class="notice sk hand">{notice}</p>}
  <section class="hero">
    <div>
      <h1 set:html={s.h1} />
      <p class="lede">{s.lede}</p>
      <form class="paste sk" method="get" action="/api/auth/github">
        <input type="hidden" name="lang" value={locale} />
        <input type="url" name="repo" placeholder={s.placeholder} aria-label="URL" />
        <button class="sk sk-btn primary" type="submit">{s.add}</button>
      </form>
      <small class="hint">{s.hint} · <a href="https://github.com/menufactory43/notacent/blob/main/src/lib/metrics.ts">{s.hintSource}</a></small>
      <div class="seek">
        <span class="hand">{s.seek}</span>
        {seek.map((x) => <a class="chip" href={x.href}>{x.label}</a>)}
      </div>
    </div>
    <Feed locale={locale} />
  </section>

  <Gains locale={locale} days={board[0]?.activeDays ?? 214} />
  <Gems locale={locale} week={gems.week} streak={gems.streak} radar={gems.radar} />

  <section id="board">
    <div class="sh">
      <h2>{tab === 'done' ? s.done : tab === 'euro' ? s.euroBoardTitle : s.boardTitle}</h2>
      <div class="seg" role="group">
        {tabs.map(([k, label]) => <a href={link({ t: k === 'all' ? '' : k })} aria-current={tab === k ? 'page' : undefined}>{label}</a>)}
      </div>
      <div class="filters">
        <a class="chip" href={link({ tool: '' })} aria-pressed={!tool ? 'true' : 'false'}>{s.allTools}</a>
        {tools.map((x) => <a class="chip" href={link({ tool: x })} aria-pressed={tool === x ? 'true' : 'false'}>{x}</a>)}
      </div>
    </div>
    {tab === 'euro' && <p class="sub hand">{s.euroBoardSub}</p>}
    {isSample && <p class="examples hand">{githubReady() ? s.emptyBoard : s.examples}</p>}
    {!isSample && board.length === 0 && <p class="examples hand">{s.nobody}</p>}
    <div class="cols hand" aria-hidden="true"><span></span><span></span><span>{s.colWeeks}</span><span class="r">{s.colDays}</span><span class="r">{s.colBravos}</span></div>
    <div class="board">
      {board.slice(0, 2).map((a, i) => <Row app={a} rank={i + 1} locale={locale} seed={i + 1} stamp={gemStamp(a.slug)} />)}
      {sponsor && <Row app={sponsor} locale={locale} seed={7} />}
      {board.slice(2).map((a, i) => <Row app={a} rank={i + 3} locale={locale} seed={i + 3} stamp={gemStamp(a.slug)} />)}
    </div>
    <p class="rules hand">{s.rulesLine} · <s>{s.r4}</s> {s.r4b}</p>
  </section>

  <Browse locale={locale} sample={isSample} />
</Base>
<style>
.notice{padding:10px 16px;margin:0 0 24px;font-size:19px;background:var(--paper-2)}
.hero{display:grid;grid-template-columns:1.3fr .9fr;gap:40px;align-items:start;margin-bottom:52px}
h1{font:700 clamp(40px,7vw,64px)/1 var(--hand);margin:0 0 12px;text-wrap:balance}
h1 :global(mark){background:linear-gradient(transparent 35%,var(--mark) 35%,var(--mark) 92%,transparent 92%);color:inherit;padding:0 4px}
.lede{max-width:52ch;margin:0 0 20px;font-size:18px}
.paste{display:flex;gap:8px;padding:6px 6px 6px 16px;align-items:center;max-width:560px}
.paste input[type=url]{flex:1;min-width:0;border:0;background:transparent;color:var(--ink);font:inherit;font-size:16px;outline:none}
.paste input::placeholder{color:var(--pencil)}
.paste:focus-within{box-shadow:0 0 0 3px var(--hilite)}
.hint{display:block;margin-top:8px;font:500 17px/1.2 var(--hand);color:var(--pencil)}
.hint a{color:inherit;text-decoration:underline dotted}
.seek{display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-top:14px}
.seek>span{font:500 17px/1 var(--hand);color:var(--pencil)}
.seek .chip{text-decoration:none}
.sh{display:flex;align-items:baseline;justify-content:space-between;gap:16px;flex-wrap:wrap;margin:0 0 8px}
.sh h2{font:700 30px/1 var(--hand);margin:0}
.filters{display:flex;gap:6px;flex-wrap:wrap;width:100%}
.chip{text-decoration:none}
.examples{color:var(--redpen);font-size:17px;margin:0 0 14px}
.sub{color:var(--pencil);font-size:18px;margin:0 0 10px}
.cols{display:grid;grid-template-columns:36px 1fr 120px 130px 72px;gap:16px;padding:0 18px;font:500 15px/1 var(--hand);color:var(--pencil);margin:6px 0 4px}
.cols .r{text-align:right}
.board{display:grid;gap:14px}
.rules{margin:16px 0 0;font:500 17px/1.3 var(--hand);color:var(--pencil)}
.rules s{color:var(--pencil)}
@media (max-width:760px){.hero{grid-template-columns:1fr}.cols{display:none}}
</style>
