---
import Spark from './Spark.astro';
import { t, localePath, type Locale } from '../i18n/strings';
import type { App } from '../data/apps';
// Une rangée du classement : rang, qui, la courbe, les jours actifs, les bravos. Le reste vit dans la fiche.
interface Props { app: App; rank?: number; locale: Locale; seed: number; stamp?: 'week' | 'streak' | 'radar' }
const { app, rank, locale, seed, stamp } = Astro.props;
const s = t(locale);
const last = app.lastCommitDaysAgo === 0 ? s.today : s.ago(app.lastCommitDaysAgo, 'j');
// La parole du maker dans la ligne : sa phrase quand il l'a écrite ; sur une fiche non réclamée, le vide visible et l'appel à réclamer.
const claimHref = `/api/auth/github?lang=${locale}&back=${encodeURIComponent(localePath(locale, `/app/${app.slug}/modifier`))}`;
const stampLabel = stamp === 'week' ? s.stampWeekShort : stamp === 'streak' ? s.stampStreak : stamp === 'radar' ? s.stampRadar : '';
---
<article class:list={['sk', 'row', { sponsor: app.sponsored, unclaimed: app.unclaimed }]}>
  {app.sponsored
    ? <><div class="rank small">{s.sponsored}</div><span class="label">{s.sponsoredLabel}</span></>
    : <div class="rank">{rank}</div>}
  <div class="who">
    <div class="logo-app" aria-hidden="true">{app.imageUrl ? <img src={app.imageUrl} alt="" loading="lazy" /> : app.name[0]}</div>
    <div class="txt">
      <p class="name">
        <a href={localePath(locale, `/app/${app.slug}`)}>{app.name}</a>
        {stampLabel && <span class="stamp red">{stampLabel}</span>}
        {app.takeover && <span class="stamp ink">{s.stampTakeover}</span>}
        {app.unclaimed && <span class="unclaimed-tag hand">{s.unclaimedStamp}</span>}
      </p>
      {app.tagline && <p class="tagline">{app.tagline}</p>}
      <p class="by">@{app.owner} <span class="tool">{app.tool}</span> · {app.language}{app.platform && <> · {app.platform}</>} · {s.last} <b>{last}</b></p>
      {app.hasLongest
        ? <p class="said">« {app.longest[locale]} »<span class="hand lbl">{s.rowLongest}</span></p>
        : app.unclaimed && <p class="said void">« <span class="blank"></span> »<span class="hand lbl">{s.rowVoid(app.owner)} · <a href={claimHref}>{s.claimShort}</a></span></p>}
    </div>
  </div>
  <Spark data={app.weekly} seed={seed} />
  <div class="metric"><b class="mono">{app.activeDays}</b><span>★ {app.stars ?? 0} · {app.activeDays30} {s.thisMonthShort}</span></div>
  <a class="sk bravo hand" href={localePath(locale, `/app/${app.slug}`)} aria-label={`${s.bravo} ${app.bravos}`}>
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M7 11V6a2 2 0 1 1 4 0v5"/><path d="M11 10V4a2 2 0 1 1 4 0v6"/><path d="M15 10V6a2 2 0 1 1 4 0v8a7 7 0 0 1-14 0v-2a2 2 0 1 1 4 0"/></svg>
    <span class="mono">{app.bravos}</span>
  </a>
  {app.margin && <span class="margin">{app.margin[locale]}</span>}
</article>
<style>
.row{display:grid;grid-template-columns:36px 1fr 120px 130px 72px;gap:16px;align-items:center;padding:14px 18px;position:relative}
.rank{font:700 34px/1 var(--hand);color:var(--pencil)}
.rank.small{font-size:14px;line-height:1.1;text-align:center}
.who{display:flex;gap:12px;align-items:center;min-width:0}
.txt{min-width:0;flex:1}
.name{font-weight:700;font-size:18px;margin:0;display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.name a{text-decoration:none;border-bottom:1.5px solid var(--faint)}
.name a:hover{border-bottom-color:var(--ink)}
.stamp{display:inline-block;transform:rotate(-3deg);border:2px double var(--redpen);color:var(--redpen);font:700 13px/1 var(--hand);padding:2px 7px;border-radius:12px 40px 14px 44px/40px 12px 44px 14px;background:var(--paper)}
.stamp.ink{border-color:var(--ink);color:var(--ink)}
.tagline{margin:1px 0 0;font-size:14px;color:var(--ink);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.by{color:var(--pencil);font-size:14px;margin:2px 0 0}
.by b{color:var(--ink);font-weight:500}
.said{margin:4px 0 0;font-size:14px;line-height:1.35;color:var(--ink);font-style:italic;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.said .lbl{font-style:normal;font-weight:700;font-size:14px;color:var(--pencil);margin-left:8px}
.said.void{color:var(--pencil)}
.said .blank{display:inline-block;width:160px;height:12px;border-bottom:1.5px dashed var(--pencil);vertical-align:baseline}
.said a{color:var(--redpen);text-decoration:none;border-bottom:1.5px solid var(--redpen)}
.tool{font:500 15px/1 var(--hand);color:var(--ink);border:1.5px solid var(--faint);border-radius:8px 30px 10px 34px/30px 8px 34px 10px;padding:1px 7px;margin-left:6px}
.metric{text-align:right}
.metric b{display:block;font-size:28px;line-height:1;font-weight:500}
.metric span{font:500 15px/1.2 var(--hand);color:var(--pencil);white-space:nowrap}
.bravo{display:inline-flex;align-items:center;gap:6px;padding:6px 10px;font:700 17px/1 var(--hand);text-decoration:none;justify-self:end;min-height:40px}
.bravo .mono{font-weight:500}
.margin{position:absolute;right:-8px;top:-14px;transform:rotate(3deg);font:700 17px/1 var(--hand);color:var(--redpen);background:var(--paper);padding:0 4px}
.sponsor{border-style:dashed;border-color:var(--pencil);background:var(--paper-2)}
.unclaimed{border-style:dashed;border-color:var(--faint)}
.unclaimed-tag{font:500 15px/1 var(--hand);color:var(--pencil);border-bottom:1.5px dashed var(--pencil)}
.label{font:700 15px/1 var(--hand);color:var(--pencil);position:absolute;top:-11px;left:24px;background:var(--paper-2);padding:0 6px}
@media (max-width:760px){
  .row{grid-template-columns:1fr 1fr;gap:10px}
  .rank{grid-column:1/-1;font-size:24px}
  .who{grid-column:1/-1}
  .metric{text-align:left;display:flex;gap:10px;align-items:baseline}
  .bravo{justify-self:end}
}
</style>
