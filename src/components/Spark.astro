---
interface Props { data: number[]; seed: number }
const { data, seed } = Astro.props;
---
<canvas class="spark" data-series={JSON.stringify(data)} data-seed={seed} width="240" height="68" aria-hidden="true"></canvas>
<style>.spark{width:120px;height:34px;display:block}</style>
<script>
  // Les sparklines sont sous la ligne de flottaison : rough.js n'est chargé et dessiné
  // qu'à l'approche de la première, pour ne pas peser sur le premier affichage.
  const canvases = document.querySelectorAll<HTMLCanvasElement>('canvas.spark');
  const draw = async () => {
    const { default: rough } = await import('roughjs');
    const css = getComputedStyle(document.documentElement);
    const ink = css.getPropertyValue('--ink').trim();
    const hil = css.getPropertyValue('--hilite').trim();
    canvases.forEach((c) => {
      if (c.dataset.drawn) return;
      c.dataset.drawn = '1';
      const d: number[] = JSON.parse(c.dataset.series || '[]');
      const seed = Number(c.dataset.seed || 1);
      const W = c.width, H = c.height;
      const rc = rough.canvas(c);
      const pts: [number, number][] = d.map((v, i) => [6 + (i * (W - 12)) / (d.length - 1), H - 6 - (v / 7) * (H - 14)]);
      rc.linearPath(pts, { stroke: ink, strokeWidth: 2, roughness: 1.4, bowing: 1.2, seed });
      const last = pts[pts.length - 1];
      rc.circle(last[0], last[1], 9, { fill: hil, fillStyle: 'solid', stroke: ink, strokeWidth: 1.5, roughness: 1.2, seed: seed + 1 });
    });
  };
  if (canvases.length) {
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        if (entries.some((e) => e.isIntersecting)) { io.disconnect(); draw(); }
      }, { rootMargin: '600px 0px' });
      canvases.forEach((c) => io.observe(c));
    } else draw();
  }
</script>
