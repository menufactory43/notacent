---
import Liste from '../../components/Liste.astro';
import { browseFromParams, withAltName } from '../../lib/browse';
export const prerender = false;
// /outil/claude-code, /plateforme/mac, /langage/swift, /intention/radar : une page par filtre.
const found = browseFromParams(Astro.params.kind ?? '', Astro.params.value ?? '');
// /alternative-a/notion n'existe que si une app s'en réclame : pas de page vide à indexer.
const b = found && (await withAltName(found));
if (!b) return new Response(null, { status: 404 });
---
<Liste locale="fr" browse={b} />
