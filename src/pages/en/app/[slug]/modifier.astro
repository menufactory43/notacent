---
import Edit from '../../../../components/Edit.astro';
import NotFound from '../../../../components/NotFound.astro';
import { editAccess } from '../../../../lib/guard';
export const prerender = false;
const access = await editAccess(Astro.cookies, 'en', Astro.params.slug ?? '');
if (access instanceof Response) return access;
if (!('app' in access)) Astro.response.status = 'notYours' in access ? 403 : 404;
---
{'app' in access ? <Edit locale="en" user={access.user} app={access.app} /> : <NotFound locale="en" notYours={'notYours' in access ? access.notYours : undefined} />}
